---
// 一个实验一页。第一屏是录屏用的一整块：标题和一句话、1px 细线框起来的舞台撑满剩下的高度、底下一行日期标签和 X 上的 @oopserian（水印，也是链接）。
// 右上角「Focus」把这一块铺满整个窗口（藏掉顶栏、页脚和下面的东西，地址加 ?focus，Esc 或浏览器的后退回来），录屏时整个窗口就是这张卡片。
// 往下是 Prompt（src/labs/<slug>/index.md 头里的 prompt，分段、保留换行，带一个拷贝按钮，太长先折起来）和源码地址，最后是上一个、下一个
import fs from 'node:fs';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LabStage from '../../components/LabStage.astro';
import Icon from '../../components/Icon.astro';
import { SITE, labSource } from '../../site';

export async function getStaticPaths() {
  const labs = (await getCollection('labs', l => !l.data.wip)).sort((a, b) => a.data.order - b.data.order);
  return labs.map((lab, i) => ({
    params: { slug: lab.id },
    props: { lab, prev: labs[i - 1], next: labs[i + 1] },
  }));
}

interface Props { lab: CollectionEntry<'labs'>; prev?: CollectionEntry<'labs'>; next?: CollectionEntry<'labs'> }
const { lab, prev, next } = Astro.props;
const { title, summary, tags, date, inspiration, prompt } = lab.data;
// 分享图：tools/og.mjs 截的 public/og/lab/<slug>.png，还没截的用全站那张
const og = `/og/lab/${lab.id}.png`;
const image = fs.existsSync(`${process.cwd()}/public${og}`) ? og : undefined;   // 构建在仓库根目录跑
const when = date.toLocaleDateString('en', { year: 'numeric', month: 'long', timeZone: 'UTC' });
const handle = '@' + new URL(SITE.x).pathname.slice(1);
---
<Base title={title} description={summary} image={image}>
  <!-- 带 ?focus 打开时，页面画出来之前就进整窗模式，不先闪一下平常的样子 -->
  <script is:inline slot="head">if (new URLSearchParams(location.search).has('focus')) document.documentElement.setAttribute('data-focus', '');</script>
  <article class="lab">
    <section class="shot wrap" aria-labelledby="lab-title">
      <div class="top mono">
        <a class="back" href="/#lab"><Icon name="arrow-left" size={14} />Lab</a>
        <button type="button" class="focus" data-focus aria-pressed="false" title="Fill the window, for screen recording. Esc to leave.">
          <Icon name="corners-out" size={14} />Focus
        </button>
      </div>
      <header>
        <h1 id="lab-title" class="display">{title}</h1>
        <p class="summary">{summary}</p>
      </header>
      <div class="frame"><LabStage slug={lab.id} size="page" /></div>
      <div class="caption mono">
        <p class="meta">{when} · {tags.join(' · ')}</p>
        <a class="handle" href={SITE.x} aria-label={`${handle} on X`}><Icon name="x" size={14} />{handle}</a>
      </div>
    </section>
    <div class="wrap below">
      <div class="notes">
        <section class="prompt" aria-labelledby="prompt-h">
          <div class="bar">
            <h2 id="prompt-h" class="eyebrow">Prompt</h2>
            <button type="button" class="copy mono" data-copy>
              <Icon name="copy" size={14} class="i-copy" /><Icon name="check" size={14} class="i-check" /><span class="label">Copy</span>
            </button>
          </div>
          <div class="body"><p class="text mono">{prompt}</p></div>
          <button type="button" class="more mono" aria-expanded="false" hidden>Show all</button>
        </section>
        <ul class="links mono">
          <li><a href={labSource(lab.id)}><Icon name="code" size={16} /><span class="out">Source on GitHub</span></a></li>
          {inspiration && <li><a href={inspiration}><Icon name="lightbulb" size={16} /><span class="out">Inspired by</span></a></li>}
        </ul>
      </div>
      <nav class="pager" aria-label="More experiments">
        {prev ? <a href={`/lab/${prev.id}/`}><span class="mono">Previous</span><span class="name">{prev.data.title}</span></a> : <span />}
        {next ? <a class="next" href={`/lab/${next.id}/`}><span class="mono">Next</span><span class="name">{next.data.title}</span></a> : <span />}
      </nav>
    </div>
  </article>
</Base>

<style>
  /* 第一屏：一屏高，舞台撑满标题和底下那行字中间剩下的高度。窗口太矮时不再压舞台，太高时也不无限拉长 */
  .shot {
    display: flex;
    flex-direction: column;
    height: calc(100svh - var(--nav-h));
    min-height: 560px;
    max-height: 1120px;
    padding-top: 24px;
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .back, .focus {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--fg-3);
    transition: color .15s;
  }
  .focus { padding: 4px 0 4px 8px; cursor: pointer; }
  .back:hover, .focus:hover { color: var(--fg); }
  header { margin: 20px 0 28px; max-width: 760px; }
  h1 { --size: 52px; }
  .summary { margin-top: 14px; font-size: 18px; color: var(--fg-2); text-wrap: pretty; }
  .frame { flex: 1; min-height: 0; display: grid; border: 1px solid var(--line); }
  .caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    min-height: 52px;
    padding-block: 12px;
    color: var(--fg-3);
    font-size: 13px;
  }
  .handle { display: inline-flex; align-items: center; gap: 6px; flex: none; color: var(--fg-2); transition: color .15s; }
  .handle:hover { color: var(--accent); }
  .below { margin-top: 40px; }
  .notes {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: 48px;
  }
  .prompt { border: 1px solid var(--line); min-width: 0; }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 6px 6px 6px 16px;
    border-bottom: 1px solid var(--line);
  }
  .copy {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    color: var(--fg-2);
    cursor: pointer;
    transition: color .15s, background-color .15s;
  }
  .copy:hover { color: var(--fg); background: var(--bg-2); }
  /* 图标在 Icon 组件里，作用域的样式够不着，用 :global */
  .copy :global(.i-check), .copy[data-done] :global(.i-copy) { display: none; }
  .copy[data-done] :global(.i-check) { display: block; }
  .copy[data-done] { color: var(--accent); }
  .text {
    padding: 16px;
    color: var(--fg-2);
    line-height: 1.7;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  /* 太长时先只露前面一截，底下渐隐，点「Show all」展开（脚本按实际高度决定要不要折） */
  .body[data-folded] {
    max-height: 360px;
    overflow: hidden;
    mask-image: linear-gradient(black 70%, transparent);
  }
  .more {
    display: block;
    width: 100%;
    padding: 10px 16px;
    border-top: 1px solid var(--line);
    text-align: left;
    color: var(--fg-2);
    cursor: pointer;
    transition: color .15s, background-color .15s;
  }
  .more[hidden] { display: none; }
  .more:hover { color: var(--fg); background: var(--bg-2); }
  .links { display: flex; flex-direction: column; gap: 10px; font-size: 13px; }
  .links a { display: inline-flex; align-items: center; gap: 8px; color: var(--fg-2); transition: color .15s; }
  .links a:hover { color: var(--accent); }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 72px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 20px 0;
    transition: color .15s;
  }
  .pager a:hover .name { color: var(--accent); }
  .pager .next { text-align: right; align-items: flex-end; border-left: 1px solid var(--line); }
  .pager .mono { color: var(--fg-3); font-size: 12px; }
  .pager .name { font-family: var(--serif); font-size: 26px; line-height: 1.1; transition: color .15s; }
  @media (max-width: 760px) {
    .shot { min-height: 520px; padding-top: 16px; }
    header { margin: 16px 0 20px; }
    h1 { --size: 40px; }
    .summary { margin-top: 10px; font-size: 16px; }
    .caption { min-height: 44px; padding-block: 10px; font-size: 12px; }
    .below { margin-top: 32px; }
    .notes { grid-template-columns: 1fr; gap: 24px; }
    .pager .name { font-size: 22px; }
  }
</style>

<style is:global>
  /* 录屏用的整窗模式（<html data-focus>）：只剩第一屏那一块，铺满窗口，四边留白跟分享图、视频一样 */
  html[data-focus] { overflow: hidden; }
  html[data-focus] body > .nav, html[data-focus] body > .foot, html[data-focus] .lab .top, html[data-focus] .lab .below { display: none; }
  html[data-focus] .lab .shot { max-width: none; height: 100svh; min-height: 0; max-height: none; padding: 44px 56px 4px; }
  @media (max-width: 760px) {
    html[data-focus] .lab .shot { padding: 24px 16px 0; }
  }
</style>

<script>
  // 「Focus」：整窗模式，录屏用。进去时往历史里记一笔（地址加 ?focus），浏览器的后退、Esc 都能出来；
  // 直接开带 ?focus 的地址也是整窗的，这时 Esc 只把地址改回去
  const focusBtn = document.querySelector<HTMLButtonElement>('[data-focus]');
  const root = document.documentElement;
  const focusUrl = (on: boolean) => { const u = new URL(location.href); if (on) u.searchParams.set('focus', ''); else u.searchParams.delete('focus'); return u.href.replace('focus=', 'focus'); };
  const setFocus = (on: boolean) => {
    root.toggleAttribute('data-focus', on);
    focusBtn?.setAttribute('aria-pressed', String(on));
    if (on) scrollTo(0, 0);
  };
  setFocus(new URLSearchParams(location.search).has('focus'));
  focusBtn?.addEventListener('click', () => { history.pushState({ focus: true }, '', focusUrl(true)); setFocus(true); });
  addEventListener('popstate', () => setFocus(new URLSearchParams(location.search).has('focus')));
  addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || e.defaultPrevented || !root.hasAttribute('data-focus')) return;
    if (history.state?.focus) history.back();
    else { history.replaceState(null, '', focusUrl(false)); setFocus(false); }
  });

  // Prompt 旁边的拷贝按钮：拷进剪贴板，按钮变成「Copied」两秒；拷不了（不是 https 这类）就把那段字选中，让人自己拷
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const text = btn.closest('.prompt')?.querySelector<HTMLElement>('.text');
    const label = btn.querySelector('.label');
    if (!text || !label) continue;
    let timer = 0;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(text.textContent ?? '');
      } catch {
        getSelection()?.selectAllChildren(text);
        return;
      }
      btn.dataset.done = '';
      label.textContent = 'Copied';
      clearTimeout(timer);
      timer = window.setTimeout(() => { delete btn.dataset.done; label.textContent = 'Copy'; }, 2000);
    });
  }

  // 长的 Prompt 先折起来：比折起的高度多出不到 120px 的就不折了，免得点开只多几行。没有脚本时整段都露着
  for (const more of document.querySelectorAll<HTMLButtonElement>('.prompt .more')) {
    const body = more.previousElementSibling as HTMLElement | null;
    if (!body || body.scrollHeight <= 360 + 120) continue;
    body.dataset.folded = '';
    more.hidden = false;
    more.addEventListener('click', () => {
      const open = body.toggleAttribute('data-folded') === false;
      more.setAttribute('aria-expanded', String(open));
      more.textContent = open ? 'Show less' : 'Show all';
      if (!open) more.closest('.prompt')?.scrollIntoView({ block: 'nearest' });
    });
  }
</script>
