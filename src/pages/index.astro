---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Sooty from '../components/Sooty.astro';
import Projects from '../components/Projects.astro';
import Labs from '../components/Labs.astro';
import Contact from '../components/Contact.astro';
---
<Base>
  <Hero />
  <Section id="now" label="Now"><Sooty /></Section>
  <Section id="work" label="Projects"><Projects /></Section>
  <Section id="lab" label="Lab"><Labs /></Section>
  <Section id="contact" label="Contact"><Contact /></Section>
</Base>
