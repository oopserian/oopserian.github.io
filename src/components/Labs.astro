---
// 实验页（/lab/）上的全部实验：排成两列，格子之间是 1px 的线，新做的在前
import { getCollection } from 'astro:content';
import LabCard from './LabCard.astro';
import { newestFirst } from '../site';

const labs = (await getCollection('labs')).sort(newestFirst);
---
<div class="grid">
  {labs.map(lab => <LabCard lab={lab} />)}
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  /* 实验是单数时第一个（最新的）占满一行，不然最后空出一格，露出底下线的颜色（2026-11-05 laken 定放前面） */
  .grid > :global(:first-child:nth-last-child(odd)) { grid-column: 1 / -1; }
  @media (max-width: 680px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
