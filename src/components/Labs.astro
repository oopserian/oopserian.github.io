---
// 「Lab」：全部实验排成两列，格子之间是 1px 的线，新做的在前
import { getCollection } from 'astro:content';
import LabCard from './LabCard.astro';
import { newestFirst } from '../site';

const labs = (await getCollection('labs')).sort(newestFirst);
---
<p class="intro">Small interface experiments, each one a single component you can play with right here. The source of every one is on GitHub.</p>
<div class="grid">
  {labs.map(lab => <LabCard lab={lab} />)}
</div>

<style>
  .intro {
    color: var(--fg-2);
    max-width: 34em;
    margin-bottom: 28px;
    text-wrap: pretty;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  /* 实验是单数时第一个（最新的）占满一行，不然最后空出一格，露出底下线的颜色（2026-11-05 laken 定放前面） */
  .grid > :global(:first-child:nth-last-child(odd)) { grid-column: 1 / -1; }
  @media (max-width: 680px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
