---
// 「Now」那一节：正在做的 SOOTY。说法照 sooty.app：名字全大写，macOS 版先出，别的系统写「coming soon」不写日期。
// 海报是 sooty.app 的分享卡片，整张放，不裁（上面有字）。
import { Image } from 'astro:assets';
import poster from '../assets/projects/sooty-og.jpg';
import icon from '../assets/projects/sooty.png';

const facts = [
  ['Interface', 'Native, written in Rust with GPUI'],
  ['Library', 'A plain folder you own, metadata in JSON'],
  ['Search', 'On-device AI, your images stay on your Mac'],
  ['Plugins', 'WebAssembly, each in its own sandbox'],
];
---
<article class="sooty">
  <a class="poster" href="https://sooty.app" tabindex="-1" aria-hidden="true">
    <Image src={poster} alt="" widths={[640, 960, 1280, 1800]} sizes="(max-width: 860px) 100vw, 920px" />
  </a>
  <div class="info">
    <div class="intro">
      <div class="head">
        <Image src={icon} alt="" width={56} height={56} densities={[1, 2]} />
        <div>
          <h3 class="display" style="--size:30px">SOOTY</h3>
          <p class="mono status"><span class="dot" aria-hidden="true"></span>In development · macOS first</p>
        </div>
      </div>
      <p class="about">
        A local-first asset manager for Mac. Images, videos, fonts, 3D models and everything else you collect live in one fast library, found again by tags, colours or a plain-language search.
        It’s named after Coal, a tabby cat.
      </p>
      <a class="cta mono" href="https://sooty.app"><span class="out">sooty.app</span></a>
    </div>
    <dl class="facts">
      {facts.map(([k, v]) => <div><dt class="mono">{k}</dt><dd>{v}</dd></div>)}
    </dl>
  </div>
</article>

<style>
  .sooty { border: 1px solid var(--line); }
  .poster {
    display: block;
    aspect-ratio: 1200 / 630;
    background: #0a0a0a;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale .6s cubic-bezier(.2, .7, .2, 1);
  }
  .poster:hover img { scale: 1.015; }
  .info {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 28px;
    border-right: 1px solid var(--line);
  }
  .head {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .head img { width: 56px; height: 56px; }
  .status {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--fg-3);
    font-size: 12px;
    margin-top: 6px;
  }
  .dot {
    width: 6px;
    height: 6px;
    background: var(--accent);
  }
  .about { color: var(--fg-2); text-wrap: pretty; }
  .facts { display: flex; flex-direction: column; }
  .facts div {
    flex: 1;
    padding: 16px 24px;
    border-bottom: 1px solid var(--line);
  }
  .facts div:last-child { border-bottom: 0; }
  dt { color: var(--fg-3); font-size: 12px; }
  dd { font-size: 15px; line-height: 1.45; margin-top: 2px; }
  .cta {
    align-self: flex-start;
    margin-top: auto;
    padding: 9px 16px;
    background: var(--fg);
    color: var(--bg);
    font-size: 14px;
    transition: opacity .15s;
  }
  .cta:hover { opacity: .85; }
  @media (max-width: 760px) {
    .info { grid-template-columns: 1fr; }
    .intro { border-right: 0; border-bottom: 1px solid var(--line); padding: 20px; }
    .facts div { padding: 14px 20px; }
  }
</style>
