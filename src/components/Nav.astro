---
// 顶栏：左边头像和名字回首页，右边三个链接和换主题的按钮。没有底色，只有模糊和一道淡线。
// 首页没有顶栏（2026-11-17 laken 要的，名字和头像在首屏简介那格里），只有实验页、详情页、404 有。
import { Image } from 'astro:assets';
import ThemeToggle from './ThemeToggle.astro';
import avatar from '../assets/avatar.webp';
import { SITE } from '../site';

const links = [
  { href: '/#work', label: 'Work' },
  { href: '/lab/', label: 'Lab' },
  { href: '/#contact', label: 'Contact' },
];
---
<header class="nav">
  <div class="wrap row">
    <a class="brand" href="/" aria-label={`${SITE.name}, home`}>
      <Image src={avatar} alt="" width={28} height={28} densities={[1, 2]} loading="eager" />
      <span>{SITE.name}</span>
    </a>
    <nav aria-label="Main">
      {links.map(l => <a class="mono" href={l.href} aria-current={l.href === '/lab/' && Astro.url.pathname.startsWith('/lab') ? 'page' : undefined}>{l.label}</a>)}
      <ThemeToggle class="toggle" />
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    height: var(--nav-h);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 60%, transparent);
  }
  .row {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--serif);
    font-size: 24px;
    line-height: 1;
  }
  .brand img {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--bg-2);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  nav a {
    padding: 6px 10px;
    color: var(--fg-2);
    transition: color .15s;
  }
  nav a:hover, nav a[aria-current] { color: var(--fg); }
  nav :global(.toggle) { margin-left: 4px; }
  @media (max-width: 420px) {
    nav a { padding: 6px 7px; }
  }
</style>
